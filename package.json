{
  "name": "bus-booking",
  "version": "1.0.0",
  "private": true,
  "description": "Tazkarty \u2014 bus ticket booking platform (Express API + React SPA)",
  "author": "Mahmoud Mohamed <mahmoudabbamalik@gmail.com>",
  "license": "ISC",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev:back": "npm --prefix back run dev",
    "dev:front": "npm --prefix front start",
    "install:all": "npm install && npm --prefix back install && npm --prefix front install",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "seed": "tsx src/scripts/seed.ts",
    "seed:admin": "tsx src/scripts/seedAdmin.ts"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.4.2"
  }
}
