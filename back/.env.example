# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. NEVER commit the real `.env`.
#
# Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=5000

# Public origin of the React app. Used in verification emails and as the
# PayPal return URL.
CLIENT_URL=http://localhost:3000

# Comma-separated CORS allowlist. Requests with no Origin header
# (curl, server-to-server) are allowed through; browsers from any other
# origin are not.
ALLOWED_ORIGINS=http://localhost:3000,https://bus-booking.vercel.app


# --- Database --------------------------------------------------------------
# MUST include the `MONGO_URI=` prefix. A bare connection string on its own
# line does nothing — dotenv only reads KEY=VALUE pairs.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/bus-booking?retryWrites=true&w=majority


# --- Authentication --------------------------------------------------------
# Two DIFFERENT secrets. Reusing one for both means a stolen access token can
# be replayed as a refresh token.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# bcrypt cost factor. Replaces the old fixed SALT value — a salt must be
# generated per password, never shared across users.
BCRYPT_ROUNDS=12

# Lifetime of an email verification / password reset code.
VERIFICATION_CODE_TTL_MINUTES=10


# --- Email (Nodemailer / Gmail) --------------------------------------------
# MAIL_PASSWORD is a Google *app password*, not your account password:
# Google Account -> Security -> 2-Step Verification -> App passwords
MAIL_SENDER=
MAIL_PASSWORD=


# --- PayPal ----------------------------------------------------------------
# developer.paypal.com -> Apps & Credentials.
# The client ID is public (it ships in the frontend bundle). The secret is not
# and must never appear in any frontend env file.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Currency PayPal orders are created in. Seat prices are stored in EGP, so a
# conversion rate is applied when charging in USD.
PAYPAL_CURRENCY=USD
EGP_TO_USD_RATE=48
