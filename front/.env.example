# ---------------------------------------------------------------------------
# Copy to `.env.local` and fill in. NEVER commit the real file.
#
# Everything here is baked into the JavaScript bundle and is therefore PUBLIC.
# Never put a secret, an API private key, or a database URI in this file.
# ---------------------------------------------------------------------------

# Base URL of the Express API, without a trailing slash.
# Local:      http://localhost:5000/api
# Production: https://booking-bus.onrender.com/api
REACT_APP_API_URL=http://localhost:5000/api

# PayPal client ID — a public identifier, safe to expose. It currently lives
# hardcoded in public/index.html; it moves here so sandbox and live can differ
# per environment.
REACT_APP_PAYPAL_CLIENT_ID=

# NOTE: from Phase 4 onward the app runs on Vite and these keys are renamed
# REACT_APP_* -> VITE_* (Vite only exposes variables with the VITE_ prefix).
