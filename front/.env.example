# ---------------------------------------------------------------------------
# Copy to `.env.local` and fill in. NEVER commit the real file.
#
# Everything here is baked into the JavaScript bundle and is therefore PUBLIC.
# Never put a secret, an API private key, or a database URI in this file.
#
# Vite only exposes variables prefixed VITE_. These were REACT_APP_* under
# Create React App; the prefix changed with the build tool in Phase 4.
# ---------------------------------------------------------------------------

# Origin of the Express API — no trailing slash, and NO /api suffix.
#
# The code appends the path itself (`${API}/api/payments/orders`), and the
# deprecated endpoints the app still calls (/login, /search) sit at the root,
# so the base has to be the bare origin.
#
# In development you can leave this empty: vite.config.ts proxies /api to
# http://localhost:5000, so requests are same-origin and CORS never applies.
#
# Production: https://booking-bus.onrender.com
VITE_API_URL=

# PayPal client id — a public identifier, safe to expose. Read by index.html
# to load the PayPal SDK, so the buttons will not render if it is missing.
# Use the *sandbox* id while testing; the secret stays on the server.
VITE_PAYPAL_CLIENT_ID=
